		"@tailwindcss/vite": "^4.0.0",
		"@types/eslint": "^9.6.1",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.0.0",
		"prettier": "^3.3.3",
